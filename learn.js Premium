========================================== */

const wishlistButtons=document.querySelectorAll(".wishlist-btn");

wishlistButtons.forEach(btn=>{

    btn.addEventListener("click",()=>{

        btn.classList.toggle("active");

        if(btn.classList.contains("active")){

            btn.innerHTML="💚";

        }else{

