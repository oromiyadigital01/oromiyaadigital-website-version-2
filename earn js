/* ==========================================
   EARNINGS COUNTER
========================================== */

document.querySelectorAll(".earn-counter").forEach(counter=>{

    const target = Number(counter.dataset.target);

    let value = 0;

    const speed = Math.ceil(target / 80);

    const timer = setInterval(()=>{

        value += speed;

        if(value >= target){

            value = target;

            clearInterval(timer);

        }

        counter.textContent = "$" + value;

    },25);

});/* ==========================================
   NOTIFICATIONS
========================================== */

function earnNotify(message){

    const box = document.createElement("div");

    box.className = "earn-notification";

    box.innerHTML = message;

    document.body.appendChild(box);

    setTimeout(()=>{

        box.classList.add("show");

    },100);

    setTimeout(()=>{

        box.classList.remove("show");

        setTimeout(()=>{

            box.remove();

        },300);

    },3000);

}/* ==========================================
   WITHDRAW
========================================== */

document.querySelectorAll(".withdraw-btn").forEach(btn=>{

    btn.addEventListener("click",()=>{

        earnNotify("💳 Withdraw Request Submitted");

    });

});/* ==========================================
   REFERRAL
========================================== */

const referralBtn = document.querySelector("#copyReferral");

if(referralBtn){

    referralBtn.addEventListener("click",()=>{

        navigator.clipboard.writeText(

            "https://oromiyaadigital.com/ref/12345"

        );

        earnNotify("🔗 Referral Link Copied");

    });

}/* ==========================================
   MONTH FILTER
========================================== */

const monthFilter = document.querySelector("#monthFilter");

if(monthFilter){

    monthFilter.addEventListener("change",()=>{

        earnNotify(

            "📅 Showing " +

            monthFilter.value +

            " report"

        );

    });

}/* ==========================================
   LOCAL SETTINGS
========================================== */

const currency = document.querySelector("#currency");

if(currency){

    currency.value =

    localStorage.getItem("currency") || "USD";

    currency.addEventListener("change",()=>{

        localStorage.setItem(

            "currency",

            currency.value

        );

    });

}/* ==========================================
   AI ADVICE
========================================== */

const aiBtn = document.querySelector("#aiFinance");

if(aiBtn){

    aiBtn.addEventListener("click",()=>{

        earnNotify(

            "🤖 AI is preparing financial advice..."

        );

    });

}/* ==========================================
   LIVE EARNINGS
========================================== */

const earningElement = document.querySelector("#liveEarnings");

if(earningElement){

    let earning = 0;

    setInterval(()=>{

        earning += Math.floor(Math.random()*5);

        earningElement.textContent="$"+earning;

    },5000);

}/* ==========================================
   REWARD PROGRESS
========================================== */

document.querySelectorAll(".reward-progress").forEach(progress=>{

    const target = Number(progress.dataset.progress);

    progress.style.width = target + "%";

});/* ==========================================
   FREELANCE
========================================== */

document.querySelectorAll(".apply-job").forEach(btn=>{

    btn.addEventListener("click",()=>{

        earnNotify("💼 Application Submitted Successfully");

    });

});/* ==========================================
