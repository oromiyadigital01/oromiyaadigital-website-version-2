/* ==========================================
   OROMIYAA DIGITAL VERSION 2.0
   PREMIUM CSS
   ========================================== */

/* ==========================
   RESET
========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Segoe UI,Roboto,sans-serif;
    background:#f7f9fc;
    color:#1d2939;
    line-height:1.7;
    overflow-x:hidden;
}

/* ==========================
   VARIABLES
========================== */

:root{

    --primary:#16a34a;
    --primary-dark:#15803d;

    --secondary:#2563eb;
    --secondary-dark:#1d4ed8;

    --gold:#fbbf24;

    --danger:#ef4444;

    --success:#22c55e;

    --dark:#0f172a;

    --text:#334155;

    --white:#ffffff;

    --light:#f8fafc;

    --border:#e2e8f0;

    --shadow:
    0 10px 30px rgba(0,0,0,.08);

    --radius:18px;

    --transition:.3s ease;

}

/* ==========================
   GLOBAL
========================== */

body{

    background:var(--light);

    color:var(--text);

}

img{

    max-width:100%;

    display:block;

}

a{

    text-decoration:none;

    color:inherit;

}

ul{

    list-style:none;

}

button{

    cursor:pointer;

    border:none;

    transition:var(--transition);

}

input,
textarea,
select{

    outline:none;

    border:1px solid var(--border);

    transition:var(--transition);

}/* ==========================
   CONTAINER
========================== */

.container{

    width:min(1200px,92%);

    margin:auto;

}

/* ==========================
   SECTION
========================== */

section{

    padding:90px 0;

}

.section-header{

    text-align:center;

    margin-bottom:60px;

}

.section-header h2{

    font-size:2.4rem;

    color:var(--dark);

    margin-bottom:15px;

}

.section-header p{

    color:#64748b;

    max-width:700px;

    margin:auto;

}

/* ==========================
   GRID
========================== */

.cards,
.creator-grid,
.market-grid,
.jobs-grid,
.learning-grid,
.community-grid,
.impact-grid,
.story-grid,
.course-grid,
.business-grid{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

    gap:25px;

}/* ==========================
   PREMIUM CARD
========================== */

.card,
.creator-card,
.market-card,
.job-card,
.learning-card,
.community-card,
.course-card,
.business-card,
.story-card,
.impact-card{

    background:var(--white);

    border-radius:var(--radius);

    padding:30px;

    box-shadow:var(--shadow);

    transition:var(--transition);

}

.card:hover,
.creator-card:hover,
.market-card:hover,
.job-card:hover,
.learning-card:hover,
.community-card:hover,
.course-card:hover,
.business-card:hover,
.story-card:hover,
.impact-card:hover{

    transform:translateY(-8px);

}

/* ==========================
   ICON
========================== */

.card h3,
.creator-card h3,
.market-card h3,
.job-card h3,
.learning-card h3{

    margin:15px 0;

    color:var(--dark);

}/* ==========================
   BUTTONS
========================== */

.primary-btn{

    display:inline-block;

    background:var(--primary);

    color:white;

    padding:14px 28px;

    border-radius:50px;

    font-weight:600;

    transition:var(--transition);

}

.primary-btn:hover{

    background:var(--primary-dark);

    transform:translateY(-2px);

}

.secondary-btn{

    display:inline-block;

    background:transparent;

    color:var(--primary);

    border:2px solid var(--primary);

    padding:14px 28px;

    border-radius:50px;

    transition:var(--transition);

}

.secondary-btn:hover{

    background:var(--primary);

    color:white;

}

.see-all{

    color:var(--secondary);

    font-weight:700;

}/* ==========================================
   PREMIUM HEADER
========================================== */

.header{

    position:sticky;

    top:0;

    left:0;

    width:100%;

    z-index:1000;

    background:rgba(255,255,255,.90);

    backdrop-filter:blur(16px);

    -webkit-backdrop-filter:blur(16px);

    box-shadow:0 2px 20px rgba(0,0,0,.06);

}

.header .container{

    display:flex;

    align-items:center;

    justify-content:space-between;

    min-height:80px;

    gap:20px;

}/* ==========================
   LOGO
========================== */

.logo{

    display:flex;

    align-items:center;

    gap:14px;

}

.logo-icon{

    width:55px;

    height:55px;

    border-radius:50%;

    background:linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
    );

    display:flex;

    align-items:center;

    justify-content:center;

    color:white;

    font-size:24px;

}

.logo-text h2{

    color:var(--dark);

    font-size:1.4rem;

}

.logo-text p{

    color:#64748b;

    font-size:.82rem;

}/* ==========================
   NAVIGATION
========================== */

.navbar{

    display:flex;

    align-items:center;

    gap:18px;

}

.navbar a{

    font-weight:600;

    color:var(--text);

    transition:var(--transition);

    position:relative;

}

.navbar a:hover{

    color:var(--primary);

}

.navbar a::after{

    content:"";

    position:absolute;

    left:0;

    bottom:-6px;

    width:0;

    height:2px;

    background:var(--primary);

    transition:.3s;

}

.navbar a:hover::after{

    width:100%;

}/* ==========================
   HEADER ACTIONS
========================== */

.header-actions{

    display:flex;

    align-items:center;

    gap:15px;

}

.language-selector{

    padding:10px 14px;

    border-radius:12px;

    border:1px solid var(--border);

    background:white;

}

.login-btn{

    padding:12px 22px;

    border-radius:50px;

    color:var(--primary);

    font-weight:600;

}

.signup-btn{

    background:var(--primary);

    color:white;

    padding:12px 24px;

    border-radius:50px;

    font-weight:600;

    transition:var(--transition);

}

.signup-btn:hover{

    background:var(--primary-dark);

}/* ==========================
   MOBILE MENU BUTTON
========================== */

.menu-btn{

    display:none;

    background:none;

    font-size:28px;

    color:var(--dark);

}

/* ==========================
   RESPONSIVE
========================== */

@media(max-width:992px){

.navbar{

    display:none;

}

.menu-btn{

    display:block;

}

.header-actions{

    display:none;

}

}/* ==========================================
   HERO SECTION
========================================== */

.hero{

    min-height:100vh;

    display:flex;

    align-items:center;

    justify-content:center;

    text-align:center;

    position:relative;

    overflow:hidden;

    background:
    linear-gradient(
        135deg,
        #ecfdf5 0%,
        #eff6ff 50%,
        #f8fafc 100%
    );

}

.hero::before{

    content:"";

    position:absolute;

    width:700px;

    height:700px;

    background:rgba(22,163,74,.08);

    border-radius:50%;

    top:-250px;

    left:-250px;

    filter:blur(40px);

}

.hero::after{

    content:"";

    position:absolute;

    width:600px;

    height:600px;

    background:rgba(37,99,235,.08);

    border-radius:50%;

    bottom:-220px;

    right:-220px;

    filter:blur(40px);

}/* ==========================
   HERO CONTENT
========================== */

.hero-content{

    position:relative;

    z-index:2;

    max-width:900px;

    padding:30px;

}

.hero-badge{

    display:inline-block;

    padding:12px 22px;

    background:white;

    border-radius:50px;

    box-shadow:var(--shadow);

    color:var(--primary);

    font-weight:700;

    margin-bottom:30px;

}

.hero h1{

    font-size:4rem;

    color:var(--dark);

    margin-bottom:25px;

    line-height:1.2;

}

.hero p{

    font-size:1.2rem;

    color:#64748b;

    max-width:700px;

    margin:0 auto 40px;

}/* ==========================
   HERO BUTTONS
========================== */

.hero-buttons{

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

}

.hero-buttons .primary-btn{

    padding:18px 38px;

    font-size:1rem;

}

.hero-buttons .secondary-btn{

    padding:18px 38px;

    font-size:1rem;

}/* ==========================
   HERO ANIMATION
========================== */

@keyframes float{

    0%{

        transform:translateY(0);

    }

    50%{

        transform:translateY(-12px);

    }

    100%{

        transform:translateY(0);

    }

}

.hero-badge{

    animation:float 4s ease-in-out infinite;

}

.hero h1{

    animation:fadeUp 1s ease;

}

.hero p{

    animation:fadeUp 1.3s ease;

}

.hero-buttons{

    animation:fadeUp 1.6s ease;

}

@keyframes fadeUp{

    from{

        opacity:0;

        transform:translateY(40px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}/* ==========================
   HERO RESPONSIVE
========================== */

@media(max-width:768px){

.hero{

    min-height:85vh;

}

.hero h1{

    font-size:2.4rem;

}

.hero p{

    font-size:1rem;

}

.hero-buttons{

    flex-direction:column;

    align-items:center;

}

.hero-buttons a{

    width:100%;

    max-width:320px;

    text-align:center;

}

}/* ==========================================
   PREMIUM CARD SYSTEM
========================================== */

.card,
.creator-card,
.market-card,
.job-card,
.learning-card,
.community-card,
.course-card,
.business-card,
.story-card,
.impact-card{

    position:relative;

    background:var(--white);

    border:1px solid rgba(255,255,255,.4);

    border-radius:24px;

    padding:35px 28px;

    overflow:hidden;

    transition:all .35s ease;

    box-shadow:
    0 12px 40px rgba(0,0,0,.08);

}

.card:hover,
.creator-card:hover,
.market-card:hover,
.job-card:hover,
.learning-card:hover,
.community-card:hover,
.course-card:hover,
.business-card:hover,
.story-card:hover,
.impact-card:hover{

    transform:translateY(-12px);

    box-shadow:
    0 25px 50px rgba(0,0,0,.15);

}/* ==========================
   TOP BORDER EFFECT
========================== */

.card::before,
.creator-card::before,
.market-card::before,
.job-card::before,
.learning-card::before{

    content:"";

    position:absolute;

    top:0;

    left:0;

    width:100%;

    height:5px;

    background:
    linear-gradient(
        90deg,
        var(--primary),
        var(--secondary),
        var(--gold)
    );

}/* ==========================
   ICON STYLE
========================== */

.card h2,
.card h3,
.creator-icon,
.crypto-icon{

    transition:.35s;

}

.card:hover h2,
.card:hover h3,
.creator-card:hover .creator-icon{

    color:var(--primary);

    transform:scale(1.08);

}

.card p{

    color:#64748b;

    margin-top:12px;

    line-height:1.8;

}/* ==========================
   BUTTON INSIDE CARD
========================== */

.card button{

    margin-top:25px;

    width:100%;

    padding:14px;

    border-radius:14px;

    background:var(--primary);

    color:white;

    font-weight:700;

}

.card button:hover{

    background:var(--primary-dark);

}/* ==========================
   CARD ANIMATION
========================== */

@keyframes cardFade{

    from{

        opacity:0;

        transform:translateY(50px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}

.card,
.creator-card,
.market-card,
.job-card,
.learning-card{

    animation:cardFade .8s ease;

}/* ==========================
   GRID RESPONSIVE
========================== */

.cards,
.creator-grid,
.market-grid,
.jobs-grid,
.learning-grid,
.community-grid{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(280px,1fr));

    gap:30px;

}/* ==========================
   MOBILE
========================== */

@media(max-width:768px){

.card,
.creator-card,
.market-card,
.job-card,
.learning-card{

    padding:24px;

}

.cards,
.creator-grid,
.market-grid,
.jobs-grid,
.learning-grid{

    gap:20px;

}

}/* ==========================================
   PREMIUM SECTION STYLE
========================================== */

.ai-section,
.crypto-hub,
.creator-economy,
.learning-center,
.jobs-center,
.community-center,
.marketplace{

    position:relative;

    padding:100px 0;

    overflow:hidden;

}

.ai-section:nth-child(even),
.crypto-hub:nth-child(even),
.creator-economy:nth-child(even),
.learning-center:nth-child(even),
.jobs-center:nth-child(even),
.community-center:nth-child(even),
.marketplace:nth-child(even){

    background:#ffffff;

}

.ai-section:nth-child(odd),
.crypto-hub:nth-child(odd),
.creator-economy:nth-child(odd),
.learning-center:nth-child(odd),
.jobs-center:nth-child(odd),
.community-center:nth-child(odd),
.marketplace:nth-child(odd){

    background:#f8fafc;

}/* ==========================
   PREMIUM ICONS
========================== */

.creator-icon,
.crypto-icon,
.ai-icon,
.job-icon,
.market-icon{

    width:80px;

    height:80px;

    border-radius:20px;

    background:linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
    );

    display:flex;

    justify-content:center;

    align-items:center;

    color:white;

    font-size:34px;

    margin-bottom:25px;

    box-shadow:0 15px 35px rgba(37,99,235,.20);

}/* ==========================
   PREMIUM TITLES
========================== */

.section-header h2{

    font-size:2.8rem;

    color:var(--dark);

    margin-bottom:18px;

}

.section-header p{

    max-width:760px;

    margin:auto;

    color:#64748b;

    font-size:1.1rem;

    line-height:1.8;

}/* ==========================
   PREMIUM SEE ALL
========================== */

.see-all{

    display:inline-flex;

    align-items:center;

    gap:10px;

    margin-top:25px;

    font-weight:700;

    color:var(--secondary);

}

.see-all:hover{

    color:var(--primary);

}/* ==========================
   FLOATING BACKGROUND
========================== */

.ai-section::before,
.crypto-hub::before,
.creator-economy::before,
.learning-center::before{

    content:"";

    position:absolute;

    width:320px;

    height:320px;

    border-radius:50%;

    background:rgba(22,163,74,.05);

    top:-100px;

    right:-100px;

    filter:blur(30px);

}/* ==========================
   PREMIUM IMAGE PLACEHOLDER
========================== */

.card img{

    width:100%;

    border-radius:18px;

    margin-bottom:20px;

    transition:.4s;

}

.card:hover img{

    transform:scale(1.05);

}/* ==========================
   RESPONSIVE
========================== */

@media(max-width:768px){

.section-header h2{

    font-size:2rem;

}

.section-header p{

    font-size:1rem;

}

.creator-icon,
.crypto-icon,
.ai-icon{

    width:65px;

    height:65px;

    font-size:28px;

}
/* ==========================================
   SMART PROFILE
========================================== */

.smart-profile{

    background:linear-gradient(
        135deg,
        #f8fafc,
        #ecfdf5
    );

}

.profile-card{

    background:white;

    border-radius:30px;

    overflow:hidden;

    box-shadow:0 20px 50px rgba(0,0,0,.08);

}

.profile-cover{

    height:220px;

    background:linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
    );

}

.profile-info{

    margin-top:-70px;

    text-align:center;

    padding:0 30px 40px;

}

.profile-avatar{

    width:140px;

    height:140px;

    margin:auto;

    border-radius:50%;

    background:white;

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:60px;

    border:6px solid white;

    box-shadow:var(--shadow);

}/* ==========================
   PROFILE STATS
========================== */

.profile-stats{

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:20px;

    margin-top:35px;

}

.profile-stats div{

    padding:20px;

    border-radius:18px;

    background:#f8fafc;

    text-align:center;

}

.profile-stats h4{

    font-size:1.6rem;

    color:var(--primary);

}

.profile-actions{

    margin-top:35px;

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

}/* ==========================================
   DIGITAL PORTFOLIO
========================================== */

.portfolio-grid{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

    gap:25px;

}

.portfolio-card{

    background:white;

    border-radius:22px;

    padding:35px;

    text-align:center;

    transition:.35s;

    box-shadow:var(--shadow);

}

.portfolio-card:hover{

    transform:translateY(-10px);

}/* ==========================================
   SUCCESS STORIES
========================================== */

.story-card{

    text-align:center;

}

.story-card h3{

    margin:20px 0;

}

.story-card:hover{

    border-bottom:5px solid var(--primary);

}/* ==========================================
   NEWSLETTER
========================================== */

.newsletter{

    text-align:center;

}

.newsletter input{

    width:100%;

    max-width:550px;

    padding:18px;

    border-radius:50px;

    margin:30px 0;

    font-size:1rem;

}/* ==========================================
   FINAL CTA
========================================== */

.final-cta{

    background:
    linear-gradient(
        135deg,
        var(--primary),
        var(--secondary)
    );

    color:white;

    text-align:center;

}

.final-cta h2{

    color:white;

    font-size:3rem;

}

.final-cta p{

    color:white;

    margin:25px auto;

    max-width:700px;

}

.cta-buttons{

    display:flex;

    justify-content:center;

    gap:20px;

    flex-wrap:wrap;

}/* ==========================================
   FOOTER
========================================== */

.footer{

    background:var(--dark);

    color:white;

    padding:70px 0 30px;

}

.footer-grid{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(220px,1fr));

    gap:35px;

}

.footer a{

    display:block;

    margin:10px 0;

    color:#cbd5e1;

    transition:.3s;

}

.footer a:hover{

    color:white;

}

.footer hr{

    margin:40px 0;

    border:none;

    border-top:1px solid rgba(255,255,255,.1);

}/* ==========================================
   RESPONSIVE
========================================== */

@media(max-width:768px){

.profile-stats{

    grid-template-columns:
    repeat(2,1fr);

}

.final-cta h2{

    font-size:2rem;

}

.profile-avatar{

    width:110px;

    height:110px;

    font-size:45px;

}

}/* ==========================================
   DARK MODE
========================================== */

body.dark-mode{

    --white:#0f172a;

    --light:#020617;

    --dark:#f8fafc;

    --text:#e2e8f0;

    --border:#334155;

    background:var(--light);

    color:var(--text);

}

body.dark-mode .card,
body.dark-mode .profile-card,
body.dark-mode .portfolio-card{

    background:#1e293b;

    color:white;

}

body.dark-mode .header{

    background:rgba(15,23,42,.90);

}

body.dark-mode .navbar a{

    color:white;

}/* ==========================================
   GLASS EFFECT
========================================== */

.glass{

    background:rgba(255,255,255,.15);

    backdrop-filter:blur(18px);

    -webkit-backdrop-filter:blur(18px);

    border:1px solid rgba(255,255,255,.25);

    border-radius:24px;

}/* ==========================================
   LIKE ANIMATION
========================================== */

@keyframes likePop{

0%{

transform:scale(.5);

opacity:0;

}

50%{

transform:scale(1.25);

}

100%{

transform:scale(1);

opacity:1;

}

}

.like-animation{

animation:likePop .35s ease;

}
}.notification-badge{

position:absolute;

top:-6px;

right:-6px;

width:20px;

height:20px;

border-radius:50%;

background:#ef4444;

color:white;

display:flex;

align-items:center;

justify-content:center;

font-size:11px;

font-weight:bold;

}.reveal{

opacity:0;

transform:translateY(50px);

transition:1s;

}

.reveal.active{

opacity:1;

transform:translateY(0);

}.video-card{

position:relative;

border-radius:24px;

overflow:hidden;

background:black;

aspect-ratio:9/16;

box-shadow:var(--shadow);

}

.video-card video{

width:100%;

height:100%;

object-fit:cover;

}

.video-overlay{

position:absolute;

left:0;

right:0;

bottom:0;

padding:20px;

background:linear-gradient(
transparent,
rgba(0,0,0,.8)
);

color:white;

}/* ==========================================
   VIDEO FEED
========================================== */

.video-feed{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(320px,1fr));

    gap:30px;

    margin-top:40px;

}

.video-card{

    position:relative;

    overflow:hidden;

    border-radius:28px;

    background:#000;

    aspect-ratio:9/16;

    box-shadow:0 20px 50px rgba(0,0,0,.18);

    transition:.35s;

}

.video-card:hover{

    transform:translateY(-10px);

}/* ==========================
   VIDEO CONTENT
========================== */

.video-card video{

    width:100%;

    height:100%;

    object-fit:cover;

}

.video-overlay{

    position:absolute;

    left:0;

    right:0;

    bottom:0;

    padding:25px;

    color:white;

    background:

    linear-gradient(

    transparent,

    rgba(0,0,0,.85)

    );

}/* ==========================
   VIDEO ACTIONS
========================== */

.video-actions{

    position:absolute;

    right:15px;

    bottom:120px;

    display:flex;

    flex-direction:column;

    gap:20px;

}

.video-actions button{

    width:58px;

    height:58px;

    border-radius:50%;

    background:rgba(255,255,255,.18);

    backdrop-filter:blur(10px);

    color:white;

    font-size:22px;

}

.video-actions button:hover{

    transform:scale(1.1);

}/* ==========================
   VIDEO PROGRESS
========================== */

.video-progress{

    position:absolute;

    left:0;

    bottom:0;

    width:100%;

    height:4px;

    background:rgba(255,255,255,.25);

}

.video-progress span{

    display:block;

    width:35%;

    height:100%;

    background:var(--primary);
/* ==========================
   CREATOR INFO
========================== */

.creator-info{

    display:flex;

    align-items:center;

    gap:12px;

    margin-bottom:15px;

}

.creator-avatar{

    width:55px;

    height:55px;

    border-radius:50%;

    background:var(--primary);

    display:flex;

    align-items:center;

    justify-content:center;

    color:white;

    font-weight:bold;

}

.creator-name{

    font-weight:700;

}/* ==========================
   CATEGORY BADGE
========================== */

.video-category{

    display:inline-block;

    padding:8px 16px;

    border-radius:50px;

    background:rgba(255,255,255,.2);

    color:white;

    font-size:.85rem;

    margin-bottom:15px;

}/* ==========================
   MOBILE
========================== */

@media(max-width:768px){

.video-feed{

grid-template-columns:1fr;

}

.video-card{

max-width:420px;

margin:auto;

}

.video-actions button{

width:50px;

height:50px;

font-size:18px;

}
/* ==========================================
   FLOATING ACTION BUTTONS
========================================== */

.floating-actions{

    position:absolute;

    right:20px;

    bottom:120px;

    display:flex;

    flex-direction:column;

    gap:18px;

}

.floating-actions button{

    width:60px;

    height:60px;

    border-radius:50%;

    border:none;

    background:rgba(255,255,255,.18);

    backdrop-filter:blur(12px);

    color:#fff;

    font-size:24px;

    transition:.3s;

}

.floating-actions button:hover{

    transform:scale(1.12);

    background:var(--primary);

}/* ==========================
   COMMENT PANEL
========================== */

.comment-panel{

    position:fixed;

    bottom:-100%;

    left:0;

    width:100%;

    height:75vh;

    background:var(--white);

    border-radius:30px 30px 0 0;

    transition:.4s;

    z-index:999;

    box-shadow:0 -10px 30px rgba(0,0,0,.15);

}

.comment-panel.active{

    bottom:0;

}/* ==========================
   SAVE EFFECT
========================== */

.save-btn.active{

    background:var(--gold);

    color:#000;
/* ==========================
   SEARCH OVERLAY
========================== */

.search-overlay{

    position:fixed;

    inset:0;

    background:rgba(0,0,0,.75);

    display:none;

    justify-content:center;

    align-items:flex-start;

    padding-top:80px;

    z-index:2000;

}

.search-overlay.active{

    display:flex;

}

.search-box{

    width:min(700px,90%);

    background:white;

    border-radius:20px;

    padding:20px;

}/* ==========================
   SKELETON LOADING
========================== */

.skeleton{

    background:

    linear-gradient(

    90deg,

    #e5e7eb 25%,

    #f3f4f6 50%,

    #e5e7eb 75%

    );

    background-size:200% 100%;

    animation:skeletonLoading 1.5s infinite;

}

@keyframes skeletonLoading{

0%{

background-position:200% 0;

}

100%{

background-position:-200% 0;

}

}/* ==========================
   PAGE TRANSITION
========================== */

.page-transition{

    animation:pageFade .5s ease;

}

@keyframes pageFade{

from{

opacity:0;

transform:translateY(20px);

}

to{

opacity:1;

transform:translateY(0);

}

}/* ==========================
   THEME BUTTON
========================== */

.theme-toggle{

    width:50px;

    height:50px;

    border-radius:50%;

    background:var(--primary);

    color:white;

    display:flex;

    justify-content:center;

    align-items:center;

    cursor:pointer;

    transition:.3s;

}

.theme-toggle:hover{

    transform:rotate(180deg);

}
}
}
}
